# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-argustv
pkgbase=${pkgname}
pkgver=21.0.1
pkgrel=1
pkgdesc="Kodi's ARGUS TV client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.argustv"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.argustv.tar.gz::https://github.com/kodi-pvr/pvr.argustv/archive/a8825c8bc15c3081fddcf80fcdf9e8f56f2274c4.tar.gz")
sha512sums=('6987741e30fdb0008c5895d89ff2c9a9dcc696f2b62546d74295ce326a5fd8524ada196fe43f444a1c290432d1bf83134629385040c7e86dd221ed668e3b4472')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.argustv-a8825c8bc15c3081fddcf80fcdf9e8f56f2274c4"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.argustv-a8825c8bc15c3081fddcf80fcdf9e8f56f2274c4/build"
  make DESTDIR="$pkgdir" install
}
