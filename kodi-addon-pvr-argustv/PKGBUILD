# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-argustv
pkgbase=${pkgname}
pkgver=21.1.1
pkgrel=2
pkgdesc="Kodi's ARGUS TV client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.argustv"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.argustv.tar.gz::https://github.com/kodi-pvr/pvr.argustv/archive/6422889370f8ae9e4c1fd20f9a30e3e9b1b54db9.tar.gz")
sha512sums=('c79f50b7f2ee120eea27ebe6b15448e569f02b3f0830a72645b8cfd846e885db582e8973ef3299daca1b6b01c14d0bcdd44f4a3fe176bdb8c6d200fff6f4edc7')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.argustv-6422889370f8ae9e4c1fd20f9a30e3e9b1b54db9"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.argustv-6422889370f8ae9e4c1fd20f9a30e3e9b1b54db9/build"
  make DESTDIR="$pkgdir" install
}
