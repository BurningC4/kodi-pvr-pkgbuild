# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-argustv
pkgbase=${pkgname}
pkgver=21.1.0
pkgrel=1
pkgdesc="Kodi's ARGUS TV client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.argustv"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.argustv.tar.gz::https://github.com/kodi-pvr/pvr.argustv/archive/7125ca471fabfd5779edcbc7f97a2398f3219cdc.tar.gz")
sha512sums=('f975848afdbcca86ad380e7e0ef4feb00de69fb3f11673c6a4034b35abbac1d7c88ff6d9e4926d22549939e04eebe7d18db318fed9bfa305e06757004832875e')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.argustv-7125ca471fabfd5779edcbc7f97a2398f3219cdc"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.argustv-7125ca471fabfd5779edcbc7f97a2398f3219cdc/build"
  make DESTDIR="$pkgdir" install
}
