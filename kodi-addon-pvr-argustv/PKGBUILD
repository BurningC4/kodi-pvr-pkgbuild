# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-argustv
pkgbase=${pkgname}
pkgver=21.1.1
pkgrel=3
pkgdesc="Kodi's ARGUS TV client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.argustv"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.argustv.tar.gz::https://github.com/kodi-pvr/pvr.argustv/archive/87b9f3bf267da0b9f8d96d7a4361b179ac63ab30.tar.gz")
sha512sums=('c11cdd9d38fe0585d0d26db52028a5b7db5fa67258535ac5412143036927bcf252999abf2eb3d72a25a9d3ea7bc7a99b88661d007b47b34c91fe47fff8ebaf28')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.argustv-87b9f3bf267da0b9f8d96d7a4361b179ac63ab30"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.argustv-87b9f3bf267da0b9f8d96d7a4361b179ac63ab30/build"
  make DESTDIR="$pkgdir" install
}
