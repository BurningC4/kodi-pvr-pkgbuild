# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-argustv
pkgbase=${pkgname}
pkgver=21.1.1
pkgrel=1
pkgdesc="Kodi's ARGUS TV client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.argustv"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.argustv.tar.gz::https://github.com/kodi-pvr/pvr.argustv/archive/e263b428057e8a9cb61fea3a651c245bf01f380b.tar.gz")
sha512sums=('e19151e9f35532cecacc1039cc38f70419b3edf990d2dfdffdbb979dac511c02ed70ecb693cc36ff282d3681d057441d01bad605e9a9a941b4f6e6e16eac5152')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.argustv-e263b428057e8a9cb61fea3a651c245bf01f380b"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.argustv-e263b428057e8a9cb61fea3a651c245bf01f380b/build"
  make DESTDIR="$pkgdir" install
}
