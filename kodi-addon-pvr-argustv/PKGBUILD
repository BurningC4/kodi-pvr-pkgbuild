# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-argustv
pkgbase=${pkgname}
pkgver=21.0.2
pkgrel=1
pkgdesc="Kodi's ARGUS TV client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.argustv"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.argustv.tar.gz::https://github.com/kodi-pvr/pvr.argustv/archive/a5658e0e0834358022b6d12130abab808e422e4f.tar.gz")
sha512sums=('355cf561ef90b811eb274880f86f3a32e9f2fc1db3aecac18c1a03deaa524915709781afa4bb3f39ebd6d8381f946803271e413b20f363526e33cede1a72215d')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.argustv-a5658e0e0834358022b6d12130abab808e422e4f"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.argustv-a5658e0e0834358022b6d12130abab808e422e4f/build"
  make DESTDIR="$pkgdir" install
}
