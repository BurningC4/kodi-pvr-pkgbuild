# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-argustv
pkgbase=${pkgname}
pkgver=20.5.0
pkgrel=8
pkgdesc="Kodi's ARGUS TV client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.argustv"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.argustv.tar.gz::https://github.com/kodi-pvr/pvr.argustv/archive/8294a830b8a9547a2e86b1f6051b16e05be67133.tar.gz")
sha512sums=('6923138e64d0ed0d8abcba887676fe10427faa69ddbb35bc9f56fc566a29bdf8a782d9bff4e1f6d2fb9a2decf681b9362cf584ff169d5bd88eead82db29ebced')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.argustv-8294a830b8a9547a2e86b1f6051b16e05be67133"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.argustv-8294a830b8a9547a2e86b1f6051b16e05be67133/build"
  make DESTDIR="$pkgdir" install
}
