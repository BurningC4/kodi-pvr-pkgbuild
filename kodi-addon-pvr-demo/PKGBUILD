# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-demo
pkgbase=${pkgname}
pkgver=21.0.3
pkgrel=1
pkgdesc="Demo PVR for Kodi"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.demo"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.demo.tar.gz::https://github.com/kodi-pvr/pvr.demo/archive/774dd1ed15ee5048285c63753314089932fc8bff.tar.gz")
sha512sums=('4fa62ba3af27742404ec50658ea701b7536ce3d6bb0a755f7fd2be35694075e74a4bc7f9db0f0412d9d9ae2dea4407d06ce1caecc41f21b8fc6387685caaf0f9')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.demo-774dd1ed15ee5048285c63753314089932fc8bff"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.demo-774dd1ed15ee5048285c63753314089932fc8bff/build"
  make DESTDIR="$pkgdir" install
}
