# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-demo
pkgbase=${pkgname}
pkgver=21.0.3
pkgrel=1
pkgdesc="Demo PVR for Kodi"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.demo"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.demo.tar.gz::https://github.com/kodi-pvr/pvr.demo/archive/3e8e122be18326e0d07decb12ad7c4f951fe0f87.tar.gz")
sha512sums=('1d4143277ae1a26c5e4ccfbb569fbc0dad9a1bb399902c525985fe2f49f6bd3fb4a619bb5b6819a47536b732dfb8b79eee189b0c26d211c0673d32489db065bc')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.demo-3e8e122be18326e0d07decb12ad7c4f951fe0f87"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.demo-3e8e122be18326e0d07decb12ad7c4f951fe0f87/build"
  make DESTDIR="$pkgdir" install
}
