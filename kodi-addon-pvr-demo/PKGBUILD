# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-demo
pkgbase=${pkgname}
pkgver=20.5.0
pkgrel=3
pkgdesc="Demo PVR for Kodi"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.demo"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.demo.tar.gz::https://github.com/kodi-pvr/pvr.demo/archive/8907161bef474deb42a972ff75e3bef1348bf953.tar.gz")
sha512sums=('e20500c7a4b5926be0f1a27078a018f0be99071abf7f3dfe8f30b57465e4e37fb5f4280c863d452135edcb9ceb3345b6a26f6a4a59687fc6f350e10a8e088218')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.demo-8907161bef474deb42a972ff75e3bef1348bf953"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.demo-8907161bef474deb42a972ff75e3bef1348bf953/build"
  make DESTDIR="$pkgdir" install
}
