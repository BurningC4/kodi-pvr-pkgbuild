# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-demo
pkgbase=${pkgname}
pkgver=21.0.1
pkgrel=1
pkgdesc="Demo PVR for Kodi"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.demo"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.demo.tar.gz::https://github.com/kodi-pvr/pvr.demo/archive/29a2e1c6711c2ba285ede3841eaf9d501db9e318.tar.gz")
sha512sums=('de6ca263e0e09f06e750b85b58547f11d69ae999ab4e6ac5ccc436096d0b8d41a8a5cb4e5e1920eaef8921d1c3d616028d8014afc4f975e7b8021aa8317f26f7')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.demo-29a2e1c6711c2ba285ede3841eaf9d501db9e318"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.demo-29a2e1c6711c2ba285ede3841eaf9d501db9e318/build"
  make DESTDIR="$pkgdir" install
}
