# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-demo
pkgbase=${pkgname}
pkgver=21.0.2
pkgrel=1
pkgdesc="Demo PVR for Kodi"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.demo"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.demo.tar.gz::https://github.com/kodi-pvr/pvr.demo/archive/a51f1b600d326b38014acb65ed9eaa92eedf1ccc.tar.gz")
sha512sums=('3d8a5799991197ea6085e23ad71c377bf0c95659ce8912c3e7f517424f2b358864b3705b40138238019e82295e4a96ac1aecd567c6296df6264fc159b58c4dfa')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.demo-a51f1b600d326b38014acb65ed9eaa92eedf1ccc"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.demo-a51f1b600d326b38014acb65ed9eaa92eedf1ccc/build"
  make DESTDIR="$pkgdir" install
}
