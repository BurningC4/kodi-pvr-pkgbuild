# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-dvblink
pkgbase=${pkgname}
pkgver=21.1.3
pkgrel=2
pkgdesc="Kodi's DVBLink client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.dvblink"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.dvblink.tar.gz::https://github.com/kodi-pvr/pvr.dvblink/archive/dbd5d5092b4a3207dda2b7d1e6ba9e51523ada1d.tar.gz")
sha512sums=('b8433f916d43dcca48ceaba1e2e1f6e388e6e4ba3afac90cc81032f5184b4d711f9c5181d86355943593a3c446331d98eeedfb1097127e9c85fc02ec26b66483')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.dvblink-dbd5d5092b4a3207dda2b7d1e6ba9e51523ada1d"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.dvblink-dbd5d5092b4a3207dda2b7d1e6ba9e51523ada1d/build"
  make DESTDIR="$pkgdir" install
}
