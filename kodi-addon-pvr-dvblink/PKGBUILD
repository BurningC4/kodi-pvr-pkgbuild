# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-dvblink
pkgbase=${pkgname}
pkgver=21.1.2
pkgrel=1
pkgdesc="Kodi's DVBLink client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.dvblink"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.dvblink.tar.gz::https://github.com/kodi-pvr/pvr.dvblink/archive/cfdbe89d998db00ba3a5b07f1891a9958cf5c9c3.tar.gz")
sha512sums=('c9781cec28c57c868cddf0bda973b0685667b23b37123843722cba3a034a34b6813881906fc2a8b728a6ca0c9e04ac883b8f65f9e80001791d7f87dc7a80e47e')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.dvblink-cfdbe89d998db00ba3a5b07f1891a9958cf5c9c3"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.dvblink-cfdbe89d998db00ba3a5b07f1891a9958cf5c9c3/build"
  make DESTDIR="$pkgdir" install
}
