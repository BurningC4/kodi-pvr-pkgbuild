# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-dvblink
pkgbase=${pkgname}
pkgver=21.1.3
pkgrel=1
pkgdesc="Kodi's DVBLink client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.dvblink"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.dvblink.tar.gz::https://github.com/kodi-pvr/pvr.dvblink/archive/1da3fd0e615277c3aa1cce68989fb0a0a3e4f3ad.tar.gz")
sha512sums=('b4ff824db512c2ce46b946b2b8364cc959c782feeeb52b62f11c476ddb2aa1b425fadba266506d8402476a7358015242654c8d4fd35721275c97947cb6995a97')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.dvblink-1da3fd0e615277c3aa1cce68989fb0a0a3e4f3ad"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.dvblink-1da3fd0e615277c3aa1cce68989fb0a0a3e4f3ad/build"
  make DESTDIR="$pkgdir" install
}
