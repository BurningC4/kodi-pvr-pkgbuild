# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-dvblink
pkgbase=${pkgname}
pkgver=21.1.1
pkgrel=2
pkgdesc="Kodi's DVBLink client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.dvblink"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.dvblink.tar.gz::https://github.com/kodi-pvr/pvr.dvblink/archive/7d2d7cbf2f55d9003a9bc51647e48869a4fd3ab9.tar.gz")
sha512sums=('97e59ccb085d2ee5c7bd50865464f6bc387eba313dee842db22ee4ecf528b8820501a489a4dcb8931e5d0b4d9c0ffdf530fe4a362c88e22c78e5bd9ec59cddd3')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.dvblink-7d2d7cbf2f55d9003a9bc51647e48869a4fd3ab9"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.dvblink-7d2d7cbf2f55d9003a9bc51647e48869a4fd3ab9/build"
  make DESTDIR="$pkgdir" install
}
