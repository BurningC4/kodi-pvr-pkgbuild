# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-dvbviewer
pkgbase=${pkgname}
pkgver=21.1.1
pkgrel=1
pkgdesc="Kodi's DVBViewer client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.dvbviewer"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.dvbviewer.tar.gz::https://github.com/kodi-pvr/pvr.dvbviewer/archive/14808cb88d8a779f4e152b256adf368b48c2e71b.tar.gz")
sha512sums=('cbf89c02534bc82724233e452cd74071c18de097831e317378d63aa88ba5d6e19ae8df572716e1c88870f789e6a04bff23299ba96ea4f5d7f7e652254b0c098e')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.dvbviewer-14808cb88d8a779f4e152b256adf368b48c2e71b"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.dvbviewer-14808cb88d8a779f4e152b256adf368b48c2e71b/build"
  make DESTDIR="$pkgdir" install
}
