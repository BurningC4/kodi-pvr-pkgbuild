# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-dvbviewer
pkgbase=${pkgname}
pkgver=20.4.0
pkgrel=3
pkgdesc="Kodi's DVBViewer client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.dvbviewer"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.dvbviewer.tar.gz::https://github.com/kodi-pvr/pvr.dvbviewer/archive/cef13bd0b8aaf33e1c60beb8a158994f0df19048.tar.gz")
sha512sums=('9242782130f31e5e5c97c96fd93823db00bfc53b6393addc78fc276e5c800fa996c4fd777885ee145583030e2132300b721f699fdb0b2d44ba6e949b3cf024aa')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.dvbviewer-cef13bd0b8aaf33e1c60beb8a158994f0df19048"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.dvbviewer-cef13bd0b8aaf33e1c60beb8a158994f0df19048/build"
  make DESTDIR="$pkgdir" install
}
