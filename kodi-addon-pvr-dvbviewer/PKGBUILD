# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-dvbviewer
pkgbase=${pkgname}
pkgver=21.1.2
pkgrel=1
pkgdesc="Kodi's DVBViewer client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.dvbviewer"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.dvbviewer.tar.gz::https://github.com/kodi-pvr/pvr.dvbviewer/archive/bfee463902d7d997a840cee67bfdda7f7d0e835a.tar.gz")
sha512sums=('c876eb48b9eb924d0f41ac94cc2934d22c7c54c9e97c91212dcda2df2835f398ed57b9af8c5d79e48e1d19015a868337cb34626de845c81f2b757f658c099c55')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.dvbviewer-bfee463902d7d997a840cee67bfdda7f7d0e835a"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.dvbviewer-bfee463902d7d997a840cee67bfdda7f7d0e835a/build"
  make DESTDIR="$pkgdir" install
}
