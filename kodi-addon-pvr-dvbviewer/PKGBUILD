# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-dvbviewer
pkgbase=${pkgname}
pkgver=21.1.3
pkgrel=2
pkgdesc="Kodi's DVBViewer client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.dvbviewer"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.dvbviewer.tar.gz::https://github.com/kodi-pvr/pvr.dvbviewer/archive/419c4b5bc2b6733b59570e86994d7e183a995f48.tar.gz")
sha512sums=('99972afa22e064e9b11bca4be202e713511f34431df79c21923295d06eb89e15cf7c6f245a0005874c30f0f57ca26fb36c223591d7c6ddcc8d4c0c4e4754d369')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.dvbviewer-419c4b5bc2b6733b59570e86994d7e183a995f48"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.dvbviewer-419c4b5bc2b6733b59570e86994d7e183a995f48/build"
  make DESTDIR="$pkgdir" install
}
