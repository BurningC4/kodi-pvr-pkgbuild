# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-filmon
pkgbase=${pkgname}
pkgver=21.0.1
pkgrel=2
pkgdesc="Kodi's Filmon client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.filmon"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.filmon.tar.gz::https://github.com/kodi-pvr/pvr.filmon/archive/435c5b86d29378bcada86dc998e69ae4828d9c2f.tar.gz")
sha512sums=('f4732adabbe81d4671afe17cae975b32771a559de368242f07a803122d969084299e8d63d9b859dc4c0e356f5d166a556969a5c0ad0ce964b8520291728f7ed4')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.filmon-435c5b86d29378bcada86dc998e69ae4828d9c2f"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.filmon-435c5b86d29378bcada86dc998e69ae4828d9c2f/build"
  make DESTDIR="$pkgdir" install
}
