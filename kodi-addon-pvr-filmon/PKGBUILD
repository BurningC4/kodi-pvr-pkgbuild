# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-filmon
pkgbase=${pkgname}
pkgver=21.0.3
pkgrel=2
pkgdesc="Kodi's Filmon client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.filmon"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.filmon.tar.gz::https://github.com/kodi-pvr/pvr.filmon/archive/8ad6a7e283a6afcc7187eac62412b0d942d14726.tar.gz")
sha512sums=('145c5b7cd22d6c55011fdecfce89d5ba6a1474a8c3f3516d551fdc87ac2959c7cba9a2d4d99f4b58756075635d93575ce253cad7b3c96f83170620542c7f57d3')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.filmon-8ad6a7e283a6afcc7187eac62412b0d942d14726"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.filmon-8ad6a7e283a6afcc7187eac62412b0d942d14726/build"
  make DESTDIR="$pkgdir" install
}
