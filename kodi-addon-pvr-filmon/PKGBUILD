# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-filmon
pkgbase=${pkgname}
pkgver=20.3.0
pkgrel=3
pkgdesc="Kodi's Filmon client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.filmon"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.filmon.tar.gz::https://github.com/kodi-pvr/pvr.filmon/archive/c6ed5fe121566c90a35b86214cc70c30fdd0d362.tar.gz")
sha512sums=('7debf98c9a9dbfaadf9a4e843a3e4ed2fdc001112dcc0b3ccd7298ef1b8e59e161976956feb064d6854a5b5dbead2a1ea684c52e55b94c439e247875078eec0d')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.filmon-c6ed5fe121566c90a35b86214cc70c30fdd0d362"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.filmon-c6ed5fe121566c90a35b86214cc70c30fdd0d362/build"
  make DESTDIR="$pkgdir" install
}
