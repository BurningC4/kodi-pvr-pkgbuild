# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-filmon
pkgbase=${pkgname}
pkgver=21.0.3
pkgrel=1
pkgdesc="Kodi's Filmon client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.filmon"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.filmon.tar.gz::https://github.com/kodi-pvr/pvr.filmon/archive/2ed6a576b74d9600a586743cbe90e0bf8049ea20.tar.gz")
sha512sums=('a1701eb21a519b16282f9c49c578286eeb2bee85ccf6fa583692c6be2a7630cf418e500f51880fca59f46fdd54c16fadd89ca5db100681ca07c4dd4055f4fec7')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.filmon-2ed6a576b74d9600a586743cbe90e0bf8049ea20"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.filmon-2ed6a576b74d9600a586743cbe90e0bf8049ea20/build"
  make DESTDIR="$pkgdir" install
}
