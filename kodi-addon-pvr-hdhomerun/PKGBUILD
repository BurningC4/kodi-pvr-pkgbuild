# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-hdhomerun
pkgbase=${pkgname}
pkgver=20.4.0
pkgrel=3
pkgdesc="Kodi's HDHomeRun client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.hdhomerun"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.hdhomerun.tar.gz::https://github.com/kodi-pvr/pvr.hdhomerun/archive/da856fc3fa0c531b5aff6e10b9e34ea4358da0ca.tar.gz")
sha512sums=('71b38f276a18001cb3e9d060b0f5d767a5681918b6d9cf133888d7623e035b2e902125ad328208209bca5182fe5896862a32c4295987535511485819c15a5bca')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.hdhomerun-da856fc3fa0c531b5aff6e10b9e34ea4358da0ca"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.hdhomerun-da856fc3fa0c531b5aff6e10b9e34ea4358da0ca/build"
  make DESTDIR="$pkgdir" install
}
