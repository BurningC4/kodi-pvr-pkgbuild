# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-hdhomerun
pkgbase=${pkgname}
pkgver=21.0.4
pkgrel=1
pkgdesc="Kodi's HDHomeRun client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.hdhomerun"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.hdhomerun.tar.gz::https://github.com/kodi-pvr/pvr.hdhomerun/archive/90439d15f6a0e3be8370343b75d7256b16a34c0e.tar.gz")
sha512sums=('417e5405e2ad8ab7034b239f42230e708147682f4afda065cdeb9515c144771c0b2d694cda170e7b761ac77f2237955e8e59f9cd5d71f3a7995edd8d9da911b0')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.hdhomerun-90439d15f6a0e3be8370343b75d7256b16a34c0e"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.hdhomerun-90439d15f6a0e3be8370343b75d7256b16a34c0e/build"
  make DESTDIR="$pkgdir" install
}
