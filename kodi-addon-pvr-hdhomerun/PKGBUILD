# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-hdhomerun
pkgbase=${pkgname}
pkgver=21.0.1
pkgrel=1
pkgdesc="Kodi's HDHomeRun client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.hdhomerun"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.hdhomerun.tar.gz::https://github.com/kodi-pvr/pvr.hdhomerun/archive/f3dc4f1c01f8dc522ebd6c9431f293d523a432bc.tar.gz")
sha512sums=('e93830e07035e7dde58339e8c3547c90fce5c34b2e8176d1c58cd6777c2b0f7fb20e8fca018057ecebfedd2af5d3a20cc285e179c827626f2c2d50610b65106f')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.hdhomerun-f3dc4f1c01f8dc522ebd6c9431f293d523a432bc"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.hdhomerun-f3dc4f1c01f8dc522ebd6c9431f293d523a432bc/build"
  make DESTDIR="$pkgdir" install
}
