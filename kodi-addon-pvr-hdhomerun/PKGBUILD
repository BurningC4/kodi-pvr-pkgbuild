# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-hdhomerun
pkgbase=${pkgname}
pkgver=21.0.2
pkgrel=1
pkgdesc="Kodi's HDHomeRun client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.hdhomerun"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.hdhomerun.tar.gz::https://github.com/kodi-pvr/pvr.hdhomerun/archive/6ebff2c43049904c554ca6e3b1869f81092ad1be.tar.gz")
sha512sums=('ec49d99aa7ba51f7b821e641aa426390ac3078576a95d1fd54316915ba1f4517e63b1997bab0ab54a47c2866dc45bc95b89c44e854abec899ebee0b2ed9a3df1')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.hdhomerun-6ebff2c43049904c554ca6e3b1869f81092ad1be"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.hdhomerun-6ebff2c43049904c554ca6e3b1869f81092ad1be/build"
  make DESTDIR="$pkgdir" install
}
