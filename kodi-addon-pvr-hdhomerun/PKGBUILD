# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-hdhomerun
pkgbase=${pkgname}
pkgver=21.0.3
pkgrel=1
pkgdesc="Kodi's HDHomeRun client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.hdhomerun"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.hdhomerun.tar.gz::https://github.com/kodi-pvr/pvr.hdhomerun/archive/77390b2dd3bb4c8943ad3947c35fdc6af608c138.tar.gz")
sha512sums=('7cb41c6884ca0409ad7f905d35d850a5789181002054c9f0fbabb4b9e8c4688bfba5d1a8f82478ed066338a95b9b2289c3dfa5d74aeb7b41a7bc02d96b0c1f95')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.hdhomerun-77390b2dd3bb4c8943ad3947c35fdc6af608c138"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.hdhomerun-77390b2dd3bb4c8943ad3947c35fdc6af608c138/build"
  make DESTDIR="$pkgdir" install
}
