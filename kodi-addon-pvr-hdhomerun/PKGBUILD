# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-hdhomerun
pkgbase=${pkgname}
pkgver=21.0.1
pkgrel=1
pkgdesc="Kodi's HDHomeRun client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.hdhomerun"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.hdhomerun.tar.gz::https://github.com/kodi-pvr/pvr.hdhomerun/archive/295c02842ae4cea06c56bec3d89eb261f9399754.tar.gz")
sha512sums=('b47d7c1cca95b833a52f169932f57d1b4b083275742e6f6baf3c62cea08d1bc0d000e3bc4f481587a38a537a5bfe65715354ee145e07f27c6cdd6e72234571cc')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.hdhomerun-295c02842ae4cea06c56bec3d89eb261f9399754"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.hdhomerun-295c02842ae4cea06c56bec3d89eb261f9399754/build"
  make DESTDIR="$pkgdir" install
}
