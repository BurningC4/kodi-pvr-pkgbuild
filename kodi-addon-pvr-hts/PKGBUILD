# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-hts
pkgbase=${pkgname}
pkgver=21.2.6
pkgrel=3
pkgdesc="Kodi's Tvheadend HTSP client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.hts"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.hts.tar.gz::https://github.com/kodi-pvr/pvr.hts/archive/bc4a254eaaa3de2383b8a5f07545e2fd3489f63b.tar.gz")
sha512sums=('b3711194e44fd7cdd8ca2814b86aae51387d99338c4115d87db853d011be3b5dfbd5c18a4a18acd77576819bb8998bc7c511e3122a764020b9a4baea21703f5f')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.hts-bc4a254eaaa3de2383b8a5f07545e2fd3489f63b"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.hts-bc4a254eaaa3de2383b8a5f07545e2fd3489f63b/build"
  make DESTDIR="$pkgdir" install
}
