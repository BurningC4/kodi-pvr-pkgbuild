# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-hts
pkgbase=${pkgname}
pkgver=21.2.5
pkgrel=3
pkgdesc="Kodi's Tvheadend HTSP client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.hts"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.hts.tar.gz::https://github.com/kodi-pvr/pvr.hts/archive/db1f2ed6cfa548a664e3d2105447e316479600fe.tar.gz")
sha512sums=('339021aab02a263c218c4ca532b0ffbe4f999008c3637fbedd06ce95e422152ffed7e87f7480ee0d5aee32ccd7d8d964e9070615f14086d470f61175d858c07d')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.hts-db1f2ed6cfa548a664e3d2105447e316479600fe"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.hts-db1f2ed6cfa548a664e3d2105447e316479600fe/build"
  make DESTDIR="$pkgdir" install
}
