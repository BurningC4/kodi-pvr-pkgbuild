# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-hts
pkgbase=${pkgname}
pkgver=21.2.4
pkgrel=2
pkgdesc="Kodi's Tvheadend HTSP client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.hts"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.hts.tar.gz::https://github.com/kodi-pvr/pvr.hts/archive/3a1b2355a26527209df6575f558dd14cfd7274b0.tar.gz")
sha512sums=('1d7b1462925c92801fa30dd1de96c03c887c3d83273cff7c43109782d09cc1a9c1d5ae5762c5224656303cb46b81e4f3f5d33e27fec4667051535867ee1ef4bb')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.hts-3a1b2355a26527209df6575f558dd14cfd7274b0"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.hts-3a1b2355a26527209df6575f558dd14cfd7274b0/build"
  make DESTDIR="$pkgdir" install
}
