# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-hts
pkgbase=${pkgname}
pkgver=20.7.2
pkgrel=2
pkgdesc="Kodi's Tvheadend HTSP client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.hts"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.hts.tar.gz::https://github.com/kodi-pvr/pvr.hts/archive/888f79c8738af81123cf9d4457b45520057f0b44.tar.gz")
sha512sums=('2139afe4e9eb591c663d182db2bba21460bef781d5a445165c1ac2e5cf278e92cd46f71de5ca57090536668084e8929485f360bc9dc171b7369a01b50041c40b')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.hts-888f79c8738af81123cf9d4457b45520057f0b44"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.hts-888f79c8738af81123cf9d4457b45520057f0b44/build"
  make DESTDIR="$pkgdir" install
}
