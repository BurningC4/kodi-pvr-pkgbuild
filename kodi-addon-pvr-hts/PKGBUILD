# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-hts
pkgbase=${pkgname}
pkgver=21.2.5
pkgrel=2
pkgdesc="Kodi's Tvheadend HTSP client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.hts"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.hts.tar.gz::https://github.com/kodi-pvr/pvr.hts/archive/117ad698d5751acbe7d749a8c5d5e229457fd61f.tar.gz")
sha512sums=('ab4e6102436f67c9d046fdcf83a091baab1db34b757a4ae480ddf586357c08d745f560db86807e88009a6713c9be1487220567638af59793b0a5cc6bfa5a0ca0')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.hts-117ad698d5751acbe7d749a8c5d5e229457fd61f"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.hts-117ad698d5751acbe7d749a8c5d5e229457fd61f/build"
  make DESTDIR="$pkgdir" install
}
