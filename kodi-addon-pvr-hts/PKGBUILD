# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-hts
pkgbase=${pkgname}
pkgver=21.2.6
pkgrel=2
pkgdesc="Kodi's Tvheadend HTSP client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.hts"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.hts.tar.gz::https://github.com/kodi-pvr/pvr.hts/archive/c145367f700346d97f1cbc882af413c94be36671.tar.gz")
sha512sums=('81658920519d148d19d4173ce3c1b49052b5ded2c33162391c1a53b5bdb01dd6a749d8760b6d1a9159ae73fba63542ad011a193056fe8b6409c22e4d479c2811')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.hts-c145367f700346d97f1cbc882af413c94be36671"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.hts-c145367f700346d97f1cbc882af413c94be36671/build"
  make DESTDIR="$pkgdir" install
}
