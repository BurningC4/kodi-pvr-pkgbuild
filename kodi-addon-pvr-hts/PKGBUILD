# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-hts
pkgbase=${pkgname}
pkgver=21.2.5
pkgrel=1
pkgdesc="Kodi's Tvheadend HTSP client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.hts"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.hts.tar.gz::https://github.com/kodi-pvr/pvr.hts/archive/5d05ec930459f2604657d358365a709cd2217a49.tar.gz")
sha512sums=('e482fe1e688bf7d2d3e2227b5b94783566ebfd80f387a413a468a34932d42db187164ff736c8d6c75fb03dd244ab55db23d66c2d795c8cf4e2ae164c99c41d75')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.hts-5d05ec930459f2604657d358365a709cd2217a49"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.hts-5d05ec930459f2604657d358365a709cd2217a49/build"
  make DESTDIR="$pkgdir" install
}
