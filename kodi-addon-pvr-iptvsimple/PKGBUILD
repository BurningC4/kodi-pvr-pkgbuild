# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-iptvsimple
pkgbase=${pkgname}
pkgver=21.9.1
pkgrel=1
pkgdesc="IPTV Simple client for Kodi PVR"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.iptvsimple"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.iptvsimple.tar.gz::https://github.com/kodi-pvr/pvr.iptvsimple/archive/287042dc30cb0a309dd6c4c21b32901ac758ba0c.tar.gz")
sha512sums=('c0bed5bc3b45faefb404f6fb0e8a8c37b683812e349eb65e0205c3f0a8c66f51382de9ada92f3d4f7e951f1734e632ce28c0b187d4eb5892a84211c765268e3e')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.iptvsimple-287042dc30cb0a309dd6c4c21b32901ac758ba0c"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.iptvsimple-287042dc30cb0a309dd6c4c21b32901ac758ba0c/build"
  make DESTDIR="$pkgdir" install
}
