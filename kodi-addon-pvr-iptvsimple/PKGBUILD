# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-iptvsimple
pkgbase=${pkgname}
pkgver=20.13.0
pkgrel=3
pkgdesc="IPTV Simple client for Kodi PVR"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.iptvsimple"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.iptvsimple.tar.gz::https://github.com/kodi-pvr/pvr.iptvsimple/archive/37b22bec6f75eb998ef2f880c421ffdb7d85c18d.tar.gz")
sha512sums=('893fab50d0dae6332e59a5e3756254e58447487d636722348463532c62ad7f3c69e2ce9f84637d86c743319bfe1b05e6945537bfeda77b2aac98dd97f30eac76')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.iptvsimple-37b22bec6f75eb998ef2f880c421ffdb7d85c18d"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.iptvsimple-37b22bec6f75eb998ef2f880c421ffdb7d85c18d/build"
  make DESTDIR="$pkgdir" install
}
