# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-iptvsimple
pkgbase=${pkgname}
pkgver=21.8.4
pkgrel=1
pkgdesc="IPTV Simple client for Kodi PVR"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.iptvsimple"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.iptvsimple.tar.gz::https://github.com/kodi-pvr/pvr.iptvsimple/archive/847750a3d3dae26218adafe2dcd18fdac2dfd358.tar.gz")
sha512sums=('0fdca670261e2611abc55ef5b6ad499f9f5f4c86f87a12b5e2c6248d4ab8c848373bea872a38bc9765d53b3a25adaa61f916f2a22c904dd29f2e4346bc5800c9')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.iptvsimple-847750a3d3dae26218adafe2dcd18fdac2dfd358"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.iptvsimple-847750a3d3dae26218adafe2dcd18fdac2dfd358/build"
  make DESTDIR="$pkgdir" install
}
