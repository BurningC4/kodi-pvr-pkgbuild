# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-iptvsimple
pkgbase=${pkgname}
pkgver=21.8.7
pkgrel=1
pkgdesc="IPTV Simple client for Kodi PVR"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.iptvsimple"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.iptvsimple.tar.gz::https://github.com/kodi-pvr/pvr.iptvsimple/archive/2cc1419ff756d54143807c1a7740bc12e5d0375b.tar.gz")
sha512sums=('86a45a04906c7c8e969803ee748b97f0d0f24c0f2bf60add6006d57c837b4b321d1cc1e0ad16033ef6e49d41481c3e43557f1d4e6cb3e34e2ac15c2a3b838a75')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.iptvsimple-2cc1419ff756d54143807c1a7740bc12e5d0375b"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.iptvsimple-2cc1419ff756d54143807c1a7740bc12e5d0375b/build"
  make DESTDIR="$pkgdir" install
}
