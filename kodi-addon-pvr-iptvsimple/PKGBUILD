# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-iptvsimple
pkgbase=${pkgname}
pkgver=21.10.1
pkgrel=2
pkgdesc="IPTV Simple client for Kodi PVR"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.iptvsimple"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.iptvsimple.tar.gz::https://github.com/kodi-pvr/pvr.iptvsimple/archive/bb513d74704ae48064417cdfeb3e7dd70dd1aea1.tar.gz")
sha512sums=('d2f9a8a96afff4dab90428a36eb309e1f846e643161e9ad61c42ae7342f435b8e081b6e938d3aa78bfdf6053a468d2457c3f064d8d9a19c4acde7eba98aa6a91')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.iptvsimple-bb513d74704ae48064417cdfeb3e7dd70dd1aea1"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.iptvsimple-bb513d74704ae48064417cdfeb3e7dd70dd1aea1/build"
  make DESTDIR="$pkgdir" install
}
