# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-iptvsimple
pkgbase=${pkgname}
pkgver=21.9.4
pkgrel=1
pkgdesc="IPTV Simple client for Kodi PVR"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.iptvsimple"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.iptvsimple.tar.gz::https://github.com/kodi-pvr/pvr.iptvsimple/archive/4665d80d2ee13c023a108f13e1f942bcb3081be7.tar.gz")
sha512sums=('09d4b8fd31e197a85b9fb9338c706c3b6161bc990861d8f0c00ff187caaa9e5232f241912ba934f91e79073ad884bcb7345521d4eb267574f71c762bfaf46b05')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.iptvsimple-4665d80d2ee13c023a108f13e1f942bcb3081be7"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.iptvsimple-4665d80d2ee13c023a108f13e1f942bcb3081be7/build"
  make DESTDIR="$pkgdir" install
}
