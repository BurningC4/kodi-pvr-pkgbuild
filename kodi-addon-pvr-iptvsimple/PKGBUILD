# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-iptvsimple
pkgbase=${pkgname}
pkgver=21.8.6
pkgrel=1
pkgdesc="IPTV Simple client for Kodi PVR"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.iptvsimple"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.iptvsimple.tar.gz::https://github.com/kodi-pvr/pvr.iptvsimple/archive/8855656ef81fb799bf7b17431308f30fbf2b0dfe.tar.gz")
sha512sums=('b810b6dd757985371e733ffe7be3a1956d45fa10d60c95d81653c3ab3a54c8e298bf9259f46c7170e86397469db0c6c739ebb03e2b85b7bd58c9bf5c614f3a1b')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.iptvsimple-8855656ef81fb799bf7b17431308f30fbf2b0dfe"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.iptvsimple-8855656ef81fb799bf7b17431308f30fbf2b0dfe/build"
  make DESTDIR="$pkgdir" install
}
