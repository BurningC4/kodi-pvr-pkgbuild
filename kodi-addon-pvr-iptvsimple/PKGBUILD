# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-iptvsimple
pkgbase=${pkgname}
pkgver=21.9.3
pkgrel=1
pkgdesc="IPTV Simple client for Kodi PVR"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.iptvsimple"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.iptvsimple.tar.gz::https://github.com/kodi-pvr/pvr.iptvsimple/archive/226288b3c3296ea3fa0cbae1dd31eaad08e7cf54.tar.gz")
sha512sums=('b60f013009db020386995e5187442d9b8ea6678e81d4e3979c242fcf359a6c44a337b2013c087e39021f04d4b8c83a015677fe1e77c6665add048f16977e1d60')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.iptvsimple-226288b3c3296ea3fa0cbae1dd31eaad08e7cf54"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.iptvsimple-226288b3c3296ea3fa0cbae1dd31eaad08e7cf54/build"
  make DESTDIR="$pkgdir" install
}
