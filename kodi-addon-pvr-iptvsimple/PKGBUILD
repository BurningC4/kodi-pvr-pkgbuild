# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-iptvsimple
pkgbase=${pkgname}
pkgver=21.8.5
pkgrel=1
pkgdesc="IPTV Simple client for Kodi PVR"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.iptvsimple"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.iptvsimple.tar.gz::https://github.com/kodi-pvr/pvr.iptvsimple/archive/cfb87e4a29364117a7e001f925e57bd31789f13d.tar.gz")
sha512sums=('f188c2926ee8186f26f4c4fd7875d87680ac3019a034bae9f51b543fd596dce27862c5dccc3d09253a68846b02d5e9b385a1c409d39e405cefefe320ccbdd605')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.iptvsimple-cfb87e4a29364117a7e001f925e57bd31789f13d"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.iptvsimple-cfb87e4a29364117a7e001f925e57bd31789f13d/build"
  make DESTDIR="$pkgdir" install
}
