# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-kofin
pkgbase=${pkgname}
pkgver=21.19.1
pkgrel=2
pkgdesc="Jellyfin PVR Client for Kodi"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.kofin"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.kofin.tar.gz::https://github.com/kodi-pvr/pvr.kofin/archive/e61e5708f0a89c9328ccc2179de31a45a8842421.tar.gz")
sha512sums=('c6d2c7478600ae71dc7ac8c139ed1887aa741f987e2a8e4338946777c3c4f102a68a05a78daa7985f7071dfdec1e4731be7937de859b20e0150e6d985efc044d')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.kofin-e61e5708f0a89c9328ccc2179de31a45a8842421"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.kofin-e61e5708f0a89c9328ccc2179de31a45a8842421/build"
  make DESTDIR="$pkgdir" install
}
