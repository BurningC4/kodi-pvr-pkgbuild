# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-kofin
pkgbase=${pkgname}
pkgver=21.19.1
pkgrel=3
pkgdesc="Jellyfin PVR Client for Kodi"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.kofin"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.kofin.tar.gz::https://github.com/kodi-pvr/pvr.kofin/archive/badffe7dd8b74b59db68ac6ac82c99f6c0c6a95c.tar.gz")
sha512sums=('880198d8fa60c3314339daab95cd99f578d9f2140f0d0c143ecb0580a9c5266292ebd98e15c354090731a37aea8bb38956f8e81cbe5a98fcc4de8dea4fee977b')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.kofin-badffe7dd8b74b59db68ac6ac82c99f6c0c6a95c"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.kofin-badffe7dd8b74b59db68ac6ac82c99f6c0c6a95c/build"
  make DESTDIR="$pkgdir" install
}
