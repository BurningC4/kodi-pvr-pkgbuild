# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-mediaportal-tvserver
pkgbase=${pkgname}
pkgver=21.0.4
pkgrel=1
pkgdesc="Kodi: MediaPortal TVServer client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.mediaportal.tvserver"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.mediaportal.tvserver.tar.gz::https://github.com/kodi-pvr/pvr.mediaportal.tvserver/archive/233664acea2e87fef3262b5a7752ac83a484e39e.tar.gz")
sha512sums=('e2d8fd4248cfb2fc700a2d281de3fcc931f4e2d86ea59c615118f953140fbaf51b1b2f20914ae68b9ac916c9be761e6cf52ef8370c9fc58c8b39a22d9dc5ab3c')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.mediaportal.tvserver-233664acea2e87fef3262b5a7752ac83a484e39e"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.mediaportal.tvserver-233664acea2e87fef3262b5a7752ac83a484e39e/build"
  make DESTDIR="$pkgdir" install
}
