# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-mediaportal-tvserver
pkgbase=${pkgname}
pkgver=21.0.3
pkgrel=2
pkgdesc="Kodi: MediaPortal TVServer client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.mediaportal.tvserver"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.mediaportal.tvserver.tar.gz::https://github.com/kodi-pvr/pvr.mediaportal.tvserver/archive/ee1bcb88a1e5d054dfc5b0684697dcb1b74af41a.tar.gz")
sha512sums=('2b66f715401ab3c263852888058ab7955d34690361204c3465f85a87042f11539cfc28b5c3d02013f0a13c24aba0f125e3e36567ded89c11d36ac64509756018')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.mediaportal.tvserver-ee1bcb88a1e5d054dfc5b0684697dcb1b74af41a"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.mediaportal.tvserver-ee1bcb88a1e5d054dfc5b0684697dcb1b74af41a/build"
  make DESTDIR="$pkgdir" install
}
