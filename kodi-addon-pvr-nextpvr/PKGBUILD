# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-nextpvr
pkgbase=${pkgname}
pkgver=21.3.2
pkgrel=2
pkgdesc="Kodi's NextPVR client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.nextpvr"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.nextpvr.tar.gz::https://github.com/kodi-pvr/pvr.nextpvr/archive/ad1c8ea0ed082e86e738db1c7dd27df15730ab1f.tar.gz")
sha512sums=('9ead4167cee2e51a017ec6816dbf3b37dab2e89769e101b5631fc262c9c3c98df65ec532dfd3d1a6109a132ff3efb1434209ad236c4e5a16a15d428c606771b7')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.nextpvr-ad1c8ea0ed082e86e738db1c7dd27df15730ab1f"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.nextpvr-ad1c8ea0ed082e86e738db1c7dd27df15730ab1f/build"
  make DESTDIR="$pkgdir" install
}
