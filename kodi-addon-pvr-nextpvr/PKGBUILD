# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-nextpvr
pkgbase=${pkgname}
pkgver=20.4.3
pkgrel=3
pkgdesc="Kodi's NextPVR client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.nextpvr"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.nextpvr.tar.gz::https://github.com/kodi-pvr/pvr.nextpvr/archive/9d968463a9c908f3eb9336292234967b877ee1c4.tar.gz")
sha512sums=('f8e55e1d0daea57dd3cb942e130c61e65d9bdbb0d441a829fae8db0cd222bbfb847db23febc0617d86e0b46192781dcb0cb0c9560d2e8b4f625f292cb37a9093')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.nextpvr-9d968463a9c908f3eb9336292234967b877ee1c4"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.nextpvr-9d968463a9c908f3eb9336292234967b877ee1c4/build"
  make DESTDIR="$pkgdir" install
}
