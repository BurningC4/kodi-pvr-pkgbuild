# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-nextpvr
pkgbase=${pkgname}
pkgver=21.2.0
pkgrel=1
pkgdesc="Kodi's NextPVR client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.nextpvr"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.nextpvr.tar.gz::https://github.com/kodi-pvr/pvr.nextpvr/archive/7b372f6fceada75cb578841c3d1acbb361ddcb8d.tar.gz")
sha512sums=('783d4d3deaaee831c99323fd0c463cab42ca84120530ca922a1badf459b884a990a9897d4045491c329bf73b391cb930ef65b8360cdb57216003d11639b4ca68')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.nextpvr-7b372f6fceada75cb578841c3d1acbb361ddcb8d"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.nextpvr-7b372f6fceada75cb578841c3d1acbb361ddcb8d/build"
  make DESTDIR="$pkgdir" install
}
