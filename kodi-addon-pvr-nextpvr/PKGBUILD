# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-nextpvr
pkgbase=${pkgname}
pkgver=21.3.2
pkgrel=1
pkgdesc="Kodi's NextPVR client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.nextpvr"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.nextpvr.tar.gz::https://github.com/kodi-pvr/pvr.nextpvr/archive/f78f8f982a8b318e96d63cc48b9de4f74491691e.tar.gz")
sha512sums=('a93208be51ee75aee2c7a1da1b0e4dc326111c7c212aec8de5317fbb875d9ec6c1424d4c9b3f4e44b63f267d7892c93d452d3a62b9e66a2647bbdf27c734958a')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.nextpvr-f78f8f982a8b318e96d63cc48b9de4f74491691e"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.nextpvr-f78f8f982a8b318e96d63cc48b9de4f74491691e/build"
  make DESTDIR="$pkgdir" install
}
