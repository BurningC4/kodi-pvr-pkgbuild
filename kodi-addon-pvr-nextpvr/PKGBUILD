# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-nextpvr
pkgbase=${pkgname}
pkgver=21.1.0
pkgrel=2
pkgdesc="Kodi's NextPVR client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.nextpvr"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.nextpvr.tar.gz::https://github.com/kodi-pvr/pvr.nextpvr/archive/88d37a091e22c5403b3a1979b88e5d42fef43028.tar.gz")
sha512sums=('4794bccb4ea1c4ddd12381ff0e2dbf6faa9dac404eda64c393e66588222928f40d699982dd1a5a51c997aaf29b6d52c2c9147b68b0dfbb2b785aa1f7f43df4ad')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.nextpvr-88d37a091e22c5403b3a1979b88e5d42fef43028"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.nextpvr-88d37a091e22c5403b3a1979b88e5d42fef43028/build"
  make DESTDIR="$pkgdir" install
}
