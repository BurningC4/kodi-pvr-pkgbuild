# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-njoy
pkgbase=${pkgname}
pkgver=21.0.1
pkgrel=1
pkgdesc="Kodi's Njoy N7 client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.njoy"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.njoy.tar.gz::https://github.com/kodi-pvr/pvr.njoy/archive/0bb08b22fa2a5ac67f0e8dc95c834e3e26c8e9f4.tar.gz")
sha512sums=('4bce0753052abccc11a0811a5d3bb2ea2c07b78dd266531c2d47448384a1176884351c3dacdb158f9c5c787b9af9bf6ef745a0baa75acad0686943654e934167')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.njoy-0bb08b22fa2a5ac67f0e8dc95c834e3e26c8e9f4"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.njoy-0bb08b22fa2a5ac67f0e8dc95c834e3e26c8e9f4/build"
  make DESTDIR="$pkgdir" install
}
