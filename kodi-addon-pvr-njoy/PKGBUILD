# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-njoy
pkgbase=${pkgname}
pkgver=21.0.2
pkgrel=3
pkgdesc="Kodi's Njoy N7 client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.njoy"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.njoy.tar.gz::https://github.com/kodi-pvr/pvr.njoy/archive/d8898e3ef3a4ff36d50b8a97f57ad9ea798c173f.tar.gz")
sha512sums=('e4c0b77a5b95d9bd917a14675f13fe7b9ea1d2577c267467348051b9ea8a01e1184d2080b0cc0bf9624205614e0d553724a107293c9b1ccd843f40b4eae3bea1')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.njoy-d8898e3ef3a4ff36d50b8a97f57ad9ea798c173f"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.njoy-d8898e3ef3a4ff36d50b8a97f57ad9ea798c173f/build"
  make DESTDIR="$pkgdir" install
}
