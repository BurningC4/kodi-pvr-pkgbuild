# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-njoy
pkgbase=${pkgname}
pkgver=21.0.1
pkgrel=2
pkgdesc="Kodi's Njoy N7 client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.njoy"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.njoy.tar.gz::https://github.com/kodi-pvr/pvr.njoy/archive/dcc6177c0fe204a2589d30726e3a574cea459887.tar.gz")
sha512sums=('190a366555ee9cb232b15192b795c6144d5365acd1dca7da136e22842fe9c6a4061f3ec2cacdc1ab9f39a5176af60d0743566aee8065251e9587a3610a3516a1')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.njoy-dcc6177c0fe204a2589d30726e3a574cea459887"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.njoy-dcc6177c0fe204a2589d30726e3a574cea459887/build"
  make DESTDIR="$pkgdir" install
}
