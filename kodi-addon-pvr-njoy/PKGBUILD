# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-njoy
pkgbase=${pkgname}
pkgver=21.0.2
pkgrel=2
pkgdesc="Kodi's Njoy N7 client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.njoy"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.njoy.tar.gz::https://github.com/kodi-pvr/pvr.njoy/archive/c4819e1ff3f3478af3517fd7288a163385709f49.tar.gz")
sha512sums=('5496cf87fcea50b1c31922483446238683888b585dd2bd6d0732cafb20553157861b5e46403918998637cc2a228fdfdb677476202164a199e186d219462c8436')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.njoy-c4819e1ff3f3478af3517fd7288a163385709f49"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.njoy-c4819e1ff3f3478af3517fd7288a163385709f49/build"
  make DESTDIR="$pkgdir" install
}
