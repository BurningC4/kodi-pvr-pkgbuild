# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-pctv
pkgbase=${pkgname}
pkgver=21.0.2
pkgrel=1
pkgdesc="Kodi's PCTV client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.pctv"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.pctv.tar.gz::https://github.com/kodi-pvr/pvr.pctv/archive/f032e8083128423e7ee7af6efbc595921b56a31d.tar.gz")
sha512sums=('48a06ea5eb6aeff4ab3485d02c125da297ee82d49250346533b7f649c7e94e110c40912df17c832e238a5817c5c8d0cc50b970cea9e99bd5be667e9c19b78e22')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.pctv-f032e8083128423e7ee7af6efbc595921b56a31d"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.pctv-f032e8083128423e7ee7af6efbc595921b56a31d/build"
  make DESTDIR="$pkgdir" install
}
