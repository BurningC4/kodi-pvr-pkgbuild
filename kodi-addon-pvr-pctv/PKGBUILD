# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-pctv
pkgbase=${pkgname}
pkgver=21.0.1
pkgrel=1
pkgdesc="Kodi's PCTV client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.pctv"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.pctv.tar.gz::https://github.com/kodi-pvr/pvr.pctv/archive/3e7137762431ac1a145f318eb8000e6bbb2a848f.tar.gz")
sha512sums=('df080267bb3496091019249c7cbe1be5623ae984cd13ef5508e7fab15fddd25e6e96da4ff0fdb74bd9742db04a1a4e950e0f52bf4ed53f6248855697ffde96a7')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.pctv-3e7137762431ac1a145f318eb8000e6bbb2a848f"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.pctv-3e7137762431ac1a145f318eb8000e6bbb2a848f/build"
  make DESTDIR="$pkgdir" install
}
