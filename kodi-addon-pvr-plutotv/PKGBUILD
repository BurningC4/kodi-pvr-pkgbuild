# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-plutotv
pkgbase=${pkgname}
pkgver=21.3.3
pkgrel=2
pkgdesc="Pluto.tv PVR Client for Kodi"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.plutotv"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.plutotv.tar.gz::https://github.com/kodi-pvr/pvr.plutotv/archive/fd8ff2c4b743d3a72f7f6dead638eb18c57ea4eb.tar.gz")
sha512sums=('728480b69fd86ea118fcc0584152ece4f9fb022784064917f0d01b1aa4e7d598ca6ec82e65f4fb48505ea641f4a05e699ba8f7080650be0c844991fe9835c6e2')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.plutotv-fd8ff2c4b743d3a72f7f6dead638eb18c57ea4eb"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.plutotv-fd8ff2c4b743d3a72f7f6dead638eb18c57ea4eb/build"
  make DESTDIR="$pkgdir" install
}
