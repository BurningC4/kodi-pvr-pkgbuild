# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-plutotv
pkgbase=${pkgname}
pkgver=21.3.1
pkgrel=1
pkgdesc="Pluto.tv PVR Client for Kodi"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.plutotv"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.plutotv.tar.gz::https://github.com/kodi-pvr/pvr.plutotv/archive/d0772e5b467999257785401db2c4e5f1b63f7eea.tar.gz")
sha512sums=('48d9f7843c3c0cbe8a720d6fb079b253ec54ac18cc91b46186cf559ac491a5d013a14ec4f72c7e1646a064183d6a3e5ef84f351511b6fe7d92acdaebf019dd5f')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.plutotv-d0772e5b467999257785401db2c4e5f1b63f7eea"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.plutotv-d0772e5b467999257785401db2c4e5f1b63f7eea/build"
  make DESTDIR="$pkgdir" install
}
