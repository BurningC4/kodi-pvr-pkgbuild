# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-plutotv
pkgbase=${pkgname}
pkgver=21.3.0
pkgrel=2
pkgdesc="Pluto.tv PVR Client for Kodi"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.plutotv"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.plutotv.tar.gz::https://github.com/kodi-pvr/pvr.plutotv/archive/b631c1e63a454ba787264bf10f33576e072f4773.tar.gz")
sha512sums=('10438bc08bf78d5ed62afd22ec1ca0b150e06fdf16aa3097cd576a3b36eaaaa54b753db498f4b46ec47dc8afe162da7622aa4562a8aad4b9fc1bbd083c74407e')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.plutotv-b631c1e63a454ba787264bf10f33576e072f4773"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.plutotv-b631c1e63a454ba787264bf10f33576e072f4773/build"
  make DESTDIR="$pkgdir" install
}
