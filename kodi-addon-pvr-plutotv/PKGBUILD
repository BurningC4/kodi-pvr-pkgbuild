# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-plutotv
pkgbase=${pkgname}
pkgver=21.3.3
pkgrel=2
pkgdesc="Pluto.tv PVR Client for Kodi"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.plutotv"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.plutotv.tar.gz::https://github.com/kodi-pvr/pvr.plutotv/archive/8810bbb0708306c15c315e96d79f58f844efaaef.tar.gz")
sha512sums=('b4b530e3ca3e9665b5d98a365c464adc722dd70d69ccec50d6aeb1058e27ce01863ce2662faf515c8684ed034255404e45f25771864db5bb8a54d772ce6ec691')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.plutotv-8810bbb0708306c15c315e96d79f58f844efaaef"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.plutotv-8810bbb0708306c15c315e96d79f58f844efaaef/build"
  make DESTDIR="$pkgdir" install
}
