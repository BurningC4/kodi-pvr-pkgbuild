# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-plutotv
pkgbase=${pkgname}
pkgver=20.3.2
pkgrel=2
pkgdesc="Pluto.tv PVR Client for Kodi"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.plutotv"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.plutotv.tar.gz::https://github.com/kodi-pvr/pvr.plutotv/archive/742322e264d8c9bb882264e1d205f6493ae36679.tar.gz")
sha512sums=('4cbb5b9e6b7cfe144529e22053d31c1c2efaa8db4f92316de7c14df2627546fb6bc43886ba32db6e9994d8220427c1b79c8c2c9c0df971f8b09f021f5804100a')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.plutotv-742322e264d8c9bb882264e1d205f6493ae36679"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.plutotv-742322e264d8c9bb882264e1d205f6493ae36679/build"
  make DESTDIR="$pkgdir" install
}
