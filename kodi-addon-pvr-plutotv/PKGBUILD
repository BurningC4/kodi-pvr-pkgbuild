# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-plutotv
pkgbase=${pkgname}
pkgver=21.3.0
pkgrel=1
pkgdesc="Pluto.tv PVR Client for Kodi"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.plutotv"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.plutotv.tar.gz::https://github.com/kodi-pvr/pvr.plutotv/archive/c91337c0bb18c0d9270bcbcdc54efa58b2e0fad7.tar.gz")
sha512sums=('a24adb211ed6053f6719aadcdf304fac1c7c902786cc9b362247dda4200ec1e2a4a57d75ea99e6ae86abd04d6734fdd4dacd35321a18d07c63526f41041fd103')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.plutotv-c91337c0bb18c0d9270bcbcdc54efa58b2e0fad7"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.plutotv-c91337c0bb18c0d9270bcbcdc54efa58b2e0fad7/build"
  make DESTDIR="$pkgdir" install
}
