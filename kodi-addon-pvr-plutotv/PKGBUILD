# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-plutotv
pkgbase=${pkgname}
pkgver=21.3.3
pkgrel=1
pkgdesc="Pluto.tv PVR Client for Kodi"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.plutotv"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.plutotv.tar.gz::https://github.com/kodi-pvr/pvr.plutotv/archive/343d1556dc730fb5d8528a09c3d46554dda4a769.tar.gz")
sha512sums=('bb1a4a86a05a443b97c4cf5eda333ff889cbc56081b873abcc428975281ea8121c172b48da872bf86b7d71ebd8215675e45fa1ae0a2ea6575ff3bb9581db0eed')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.plutotv-343d1556dc730fb5d8528a09c3d46554dda4a769"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.plutotv-343d1556dc730fb5d8528a09c3d46554dda4a769/build"
  make DESTDIR="$pkgdir" install
}
