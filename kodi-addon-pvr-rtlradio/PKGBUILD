# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-rtlradio
pkgbase=${pkgname}
pkgver=21.0.0
pkgrel=1
pkgdesc="Realtek RTL2832U RTL-SDR Radio PVR Client"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.rtlradio"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.rtlradio.tar.gz::https://github.com/kodi-pvr/pvr.rtlradio/archive/4e16c94fc6d88cf51c752359c4ea6a1fa48b0aa2.tar.gz")
sha512sums=('0901e01a88540e232eeeec74b981d28b011060040543d8dce1070e16d883b94c782e59652f77eb151a91080eb949f3179e3f59f82d6cb53c8bacc405f9ac0f25')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.rtlradio-4e16c94fc6d88cf51c752359c4ea6a1fa48b0aa2"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.rtlradio-4e16c94fc6d88cf51c752359c4ea6a1fa48b0aa2/build"
  make DESTDIR="$pkgdir" install
}
