# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-stalker
pkgbase=${pkgname}
pkgver=21.1.0
pkgrel=1
pkgdesc="A PVR Client that connects Kodi to Stalker Middleware"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.stalker"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.stalker.tar.gz::https://github.com/kodi-pvr/pvr.stalker/archive/f98b7606d27f3443564b530c70657b2a61e1f6ac.tar.gz")
sha512sums=('35b00599770eb6862b7e50d4f3670cf15d5eb42780799581d6f78f13fd92b73b428e72cc90bf57b64efe8740a30704a8561067a66fe00e0ad6208f182a04032a')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.stalker-f98b7606d27f3443564b530c70657b2a61e1f6ac"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.stalker-f98b7606d27f3443564b530c70657b2a61e1f6ac/build"
  make DESTDIR="$pkgdir" install
}
