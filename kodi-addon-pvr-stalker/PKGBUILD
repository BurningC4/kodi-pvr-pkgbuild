# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-stalker
pkgbase=${pkgname}
pkgver=20.3.1
pkgrel=3
pkgdesc="A PVR Client that connects Kodi to Stalker Middleware"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.stalker"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.stalker.tar.gz::https://github.com/kodi-pvr/pvr.stalker/archive/009da0f7827ec24a9363f9707e6b95c25fabc725.tar.gz")
sha512sums=('9bfd976a0980fcd07d28b406ccef6721c9ec150bf7ec8a0ef8e2921d4a6ad80f123601f5802c78d4e40e01424462cf94f8032c01ef38b9b7c9af5685d54867ad')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.stalker-009da0f7827ec24a9363f9707e6b95c25fabc725"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.stalker-009da0f7827ec24a9363f9707e6b95c25fabc725/build"
  make DESTDIR="$pkgdir" install
}
