# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-stalker
pkgbase=${pkgname}
pkgver=21.0.1
pkgrel=1
pkgdesc="A PVR Client that connects Kodi to Stalker Middleware"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.stalker"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.stalker.tar.gz::https://github.com/kodi-pvr/pvr.stalker/archive/49ac15a0c74448fcbbc665ca82e80d907ba3e5b0.tar.gz")
sha512sums=('d18ef4872f265892008e96b2f685403169c9d27947239b6d958f032ed2ae59f2d93707b77840ed18f50224d819565246e8b38d6ae26876e819538d653c2f17a7')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.stalker-49ac15a0c74448fcbbc665ca82e80d907ba3e5b0"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.stalker-49ac15a0c74448fcbbc665ca82e80d907ba3e5b0/build"
  make DESTDIR="$pkgdir" install
}
