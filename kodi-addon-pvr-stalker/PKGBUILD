# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-stalker
pkgbase=${pkgname}
pkgver=21.1.3
pkgrel=1
pkgdesc="A PVR Client that connects Kodi to Stalker Middleware"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.stalker"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.stalker.tar.gz::https://github.com/kodi-pvr/pvr.stalker/archive/b05ee29bba1a86fe75377e4c6216c9e6ee68d221.tar.gz")
sha512sums=('11f66d972fff6a39a6ca1942d4157afb55d5f88aaf06c30fa9d86042ebbcf9576d240ffd715bf037bac7ffa8e4f7bf23b6f99ddbaff7ae0e22b688795955cf42')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.stalker-b05ee29bba1a86fe75377e4c6216c9e6ee68d221"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.stalker-b05ee29bba1a86fe75377e4c6216c9e6ee68d221/build"
  make DESTDIR="$pkgdir" install
}
