# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-stalker
pkgbase=${pkgname}
pkgver=21.1.2
pkgrel=1
pkgdesc="A PVR Client that connects Kodi to Stalker Middleware"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.stalker"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.stalker.tar.gz::https://github.com/kodi-pvr/pvr.stalker/archive/ec0a75f4d09c85e5ef66a359de09bd3116df9557.tar.gz")
sha512sums=('554c95d637acbe401f8490dfe92e48ff7c15455091f3cda70a2374a8f072b48ef5e577f23a82b55472e531079a635f066ca0f4f63cc1e66c8c5e9d8cf3a0123d')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.stalker-ec0a75f4d09c85e5ef66a359de09bd3116df9557"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.stalker-ec0a75f4d09c85e5ef66a359de09bd3116df9557/build"
  make DESTDIR="$pkgdir" install
}
