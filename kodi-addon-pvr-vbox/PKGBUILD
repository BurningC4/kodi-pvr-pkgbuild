# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-vbox
pkgbase=${pkgname}
pkgver=21.1.3
pkgrel=2
pkgdesc="Kodi VBox TV Gateway PVR addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.vbox"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.vbox.tar.gz::https://github.com/kodi-pvr/pvr.vbox/archive/8f5c0fe750741cd873d589282ab0fd9793e9c11b.tar.gz")
sha512sums=('d76c38e6f4b5f73e51e81c680155ed90ba5b9eef7fbbb1c27c1df93d61de6558fa900375528a9aa9116259886d2307c3ff37dc5c68c236ac8bb798c624a90391')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.vbox-8f5c0fe750741cd873d589282ab0fd9793e9c11b"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.vbox-8f5c0fe750741cd873d589282ab0fd9793e9c11b/build"
  make DESTDIR="$pkgdir" install
}
