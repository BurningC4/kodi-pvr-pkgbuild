# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-vbox
pkgbase=${pkgname}
pkgver=20.4.2
pkgrel=3
pkgdesc="Kodi VBox TV Gateway PVR addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.vbox"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.vbox.tar.gz::https://github.com/kodi-pvr/pvr.vbox/archive/cc3e2e105da5ee78fcb03e28efbce98e6eedca0c.tar.gz")
sha512sums=('bf1ad5077475de22db65bf0d4cbe3194bc09cb90d1759654bb24159e96244d3501bb2e5e1ee9e712245fcf4b24dc1e1fb060b7bb086477c00de892e2f54cca1a')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.vbox-cc3e2e105da5ee78fcb03e28efbce98e6eedca0c"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.vbox-cc3e2e105da5ee78fcb03e28efbce98e6eedca0c/build"
  make DESTDIR="$pkgdir" install
}
