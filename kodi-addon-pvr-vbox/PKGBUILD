# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-vbox
pkgbase=${pkgname}
pkgver=21.1.5
pkgrel=2
pkgdesc="Kodi VBox TV Gateway PVR addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.vbox"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.vbox.tar.gz::https://github.com/kodi-pvr/pvr.vbox/archive/3ec6644a9a344fc64d17c2ed56a1b3867d0f89bc.tar.gz")
sha512sums=('9dc7ddd62bfa228710cc4877c75149e94140e8acbc7a271caaf51ed80c615ed2f0e296b5f8d99d4f442c4bede0d4d16ebe678618a162452986e68ee5b174d605')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.vbox-3ec6644a9a344fc64d17c2ed56a1b3867d0f89bc"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.vbox-3ec6644a9a344fc64d17c2ed56a1b3867d0f89bc/build"
  make DESTDIR="$pkgdir" install
}
