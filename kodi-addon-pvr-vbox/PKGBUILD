# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-vbox
pkgbase=${pkgname}
pkgver=21.1.5
pkgrel=2
pkgdesc="Kodi VBox TV Gateway PVR addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.vbox"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.vbox.tar.gz::https://github.com/kodi-pvr/pvr.vbox/archive/abcaaeb10a618bb81eea30ef08270e1967bb679b.tar.gz")
sha512sums=('fc969c61ecff3eedb8748755fd05e236697fe3bcac0e61fb58dc70b2b8726e209d501dcfc95d7779530c2912d2aa7bca2fad7d80f23052121a27840fa15d99c3')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.vbox-abcaaeb10a618bb81eea30ef08270e1967bb679b"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.vbox-abcaaeb10a618bb81eea30ef08270e1967bb679b/build"
  make DESTDIR="$pkgdir" install
}
