# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-vdr-vnsi
pkgbase=${pkgname}
pkgver=21.1.2
pkgrel=1
pkgdesc="Kodi PVR addon VNSI"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.vdr.vnsi"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.vdr.vnsi.tar.gz::https://github.com/kodi-pvr/pvr.vdr.vnsi/archive/27906c5b8f74583724db98e3fb6cfa6186a73bd4.tar.gz")
sha512sums=('35e2b1c9481444e7078a46511e6ed6fd636d103c25fd6a64f0ee8c5b6cf127d856a16fda2d601c3c07ae72216d3cb0ac1a7e37dac297230b49a1bed4fca29b8d')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.vdr.vnsi-27906c5b8f74583724db98e3fb6cfa6186a73bd4"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.vdr.vnsi-27906c5b8f74583724db98e3fb6cfa6186a73bd4/build"
  make DESTDIR="$pkgdir" install
}
