# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-vdr-vnsi
pkgbase=${pkgname}
pkgver=21.1.3
pkgrel=2
pkgdesc="Kodi PVR addon VNSI"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.vdr.vnsi"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.vdr.vnsi.tar.gz::https://github.com/kodi-pvr/pvr.vdr.vnsi/archive/3663bf2505dfe66e4a25562ae94e1552b8558cee.tar.gz")
sha512sums=('9071d95032a722a4f6adf32701792f08788f17a31bf6a9ab5e259c581717cc8721deb666990a14d57335169180798c3583ef421f60eb7859853f214b7406a59a')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.vdr.vnsi-3663bf2505dfe66e4a25562ae94e1552b8558cee"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.vdr.vnsi-3663bf2505dfe66e4a25562ae94e1552b8558cee/build"
  make DESTDIR="$pkgdir" install
}
