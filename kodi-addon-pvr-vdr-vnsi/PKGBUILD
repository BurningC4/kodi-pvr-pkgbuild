# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-vdr-vnsi
pkgbase=${pkgname}
pkgver=21.1.3
pkgrel=1
pkgdesc="Kodi PVR addon VNSI"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.vdr.vnsi"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.vdr.vnsi.tar.gz::https://github.com/kodi-pvr/pvr.vdr.vnsi/archive/fc3739419a2829858ec54e4d9952c3b25beb9c59.tar.gz")
sha512sums=('4c3fc50d926d1866944c23e791b311f51e226c4bedadc304d4912d74e26553e2db4da1b105605a46c90da3423a1a457396aa8a3831d081dc2b18e6980b03b7f7')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.vdr.vnsi-fc3739419a2829858ec54e4d9952c3b25beb9c59"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.vdr.vnsi-fc3739419a2829858ec54e4d9952c3b25beb9c59/build"
  make DESTDIR="$pkgdir" install
}
