# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-vdr-vnsi
pkgbase=${pkgname}
pkgver=21.1.1
pkgrel=1
pkgdesc="Kodi PVR addon VNSI"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.vdr.vnsi"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.vdr.vnsi.tar.gz::https://github.com/kodi-pvr/pvr.vdr.vnsi/archive/3a1b449d7484cb52e155487a4f1f6baa8075ded9.tar.gz")
sha512sums=('d57446f74856d971f9f65033ba6a4807e692e2849ab76ee11bf27f35ceb9b3ce206bb5607fd988b8b1907de8555cd62698da016bfbe58a804743699b5f4a60e3')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.vdr.vnsi-3a1b449d7484cb52e155487a4f1f6baa8075ded9"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.vdr.vnsi-3a1b449d7484cb52e155487a4f1f6baa8075ded9/build"
  make DESTDIR="$pkgdir" install
}
