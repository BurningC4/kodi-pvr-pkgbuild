# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-vdr-vnsi
pkgbase=${pkgname}
pkgver=20.4.1
pkgrel=13
pkgdesc="Kodi PVR addon VNSI"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.vdr.vnsi"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.vdr.vnsi.tar.gz::https://github.com/kodi-pvr/pvr.vdr.vnsi/archive/08d421fb96d790fd8e26da28e7f4cfae843b4001.tar.gz")
sha512sums=('bb329b023b124e0361c72fffaa7dd1669e74c52e9d0f640de1b6646cc269be103cfbc39660150bc73f118f072f78ba3f6ef91e4190a91e7d896aa621086a23da')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.vdr.vnsi-08d421fb96d790fd8e26da28e7f4cfae843b4001"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.vdr.vnsi-08d421fb96d790fd8e26da28e7f4cfae843b4001/build"
  make DESTDIR="$pkgdir" install
}
