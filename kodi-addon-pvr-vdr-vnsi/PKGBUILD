# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-vdr-vnsi
pkgbase=${pkgname}
pkgver=21.1.3
pkgrel=3
pkgdesc="Kodi PVR addon VNSI"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.vdr.vnsi"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.vdr.vnsi.tar.gz::https://github.com/kodi-pvr/pvr.vdr.vnsi/archive/6b4c76cdadb3737c944d19539f6f3eb2761896d4.tar.gz")
sha512sums=('00e95356b6fe5c97b53464ae9f4fff76f745e274f4e459ba31af168171a73859f3e499ef51cbf5590852ddf81c5ae78df5a74ca56ff2b897f5b547ac460ba599')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.vdr.vnsi-6b4c76cdadb3737c944d19539f6f3eb2761896d4"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.vdr.vnsi-6b4c76cdadb3737c944d19539f6f3eb2761896d4/build"
  make DESTDIR="$pkgdir" install
}
