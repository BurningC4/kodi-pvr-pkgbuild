# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-vuplus
pkgbase=${pkgname}
pkgver=21.3.1
pkgrel=1
pkgdesc="Kodi's Enigma2 client add-on"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.vuplus"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.vuplus.tar.gz::https://github.com/kodi-pvr/pvr.vuplus/archive/b0cdedad2de7bdad66289e1e1ba800a600e840a0.tar.gz")
sha512sums=('c880abbc8cfe8cf0d16811b873272c3c234dc478fb22ed605708f8160104c669c8878a47075087c88aa969bcadd6bf465dbf1719d4955f6a10deced62e20c175')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.vuplus-b0cdedad2de7bdad66289e1e1ba800a600e840a0"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.vuplus-b0cdedad2de7bdad66289e1e1ba800a600e840a0/build"
  make DESTDIR="$pkgdir" install
}
