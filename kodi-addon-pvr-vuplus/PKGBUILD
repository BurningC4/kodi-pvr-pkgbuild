# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-vuplus
pkgbase=${pkgname}
pkgver=21.2.0
pkgrel=2
pkgdesc="Kodi's Enigma2 client add-on"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.vuplus"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.vuplus.tar.gz::https://github.com/kodi-pvr/pvr.vuplus/archive/51c9a19eb765a5cc20e24faa53e4958671a5aed4.tar.gz")
sha512sums=('0d6e66987102a2b645e35ab1602e820cb51f5e6b50cb00e6f769cfbea542ff93fdeb27e276d9aec0a9a44e544b3ff5a5f7443b238b70858c38de6936e1f0f996')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.vuplus-51c9a19eb765a5cc20e24faa53e4958671a5aed4"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.vuplus-51c9a19eb765a5cc20e24faa53e4958671a5aed4/build"
  make DESTDIR="$pkgdir" install
}
