# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-vuplus
pkgbase=${pkgname}
pkgver=21.3.2
pkgrel=1
pkgdesc="Kodi's Enigma2 client add-on"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.vuplus"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.vuplus.tar.gz::https://github.com/kodi-pvr/pvr.vuplus/archive/bb08bbc351eff4e5fbd7dac9f1c46ddf1aae1a4b.tar.gz")
sha512sums=('2563f2e3d4880a5d36fab34094d0714d2494ed33e3ab9bb8e09a3922384017aa4811ccaf6f2fc0c11a10f6f938e9fe0fe96c35c33a9625a7f0655c27f4eff3b3')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.vuplus-bb08bbc351eff4e5fbd7dac9f1c46ddf1aae1a4b"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.vuplus-bb08bbc351eff4e5fbd7dac9f1c46ddf1aae1a4b/build"
  make DESTDIR="$pkgdir" install
}
