# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-vuplus
pkgbase=${pkgname}
pkgver=21.3.0
pkgrel=1
pkgdesc="Kodi's Enigma2 client add-on"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.vuplus"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.vuplus.tar.gz::https://github.com/kodi-pvr/pvr.vuplus/archive/04a4fddb9451c5573da5ce30e77274550ff80a16.tar.gz")
sha512sums=('42db521bb0e7fd8e11c006a5770ea578bfc1a9adbb93bf7a8df6f10829439a45b2ad6f1cdca3f74479e02ea451d9b450117c025614c445c1ca81c8f0d4c10190')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.vuplus-04a4fddb9451c5573da5ce30e77274550ff80a16"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.vuplus-04a4fddb9451c5573da5ce30e77274550ff80a16/build"
  make DESTDIR="$pkgdir" install
}
