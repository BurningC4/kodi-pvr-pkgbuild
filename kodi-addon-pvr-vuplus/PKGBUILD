# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-vuplus
pkgbase=${pkgname}
pkgver=21.2.0
pkgrel=1
pkgdesc="Kodi's Enigma2 client add-on"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.vuplus"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.vuplus.tar.gz::https://github.com/kodi-pvr/pvr.vuplus/archive/3cc5547eb55b1711cac1068bb3a5096e46b2cecd.tar.gz")
sha512sums=('3cbfd777c5df03aef7187b15b6c3d3f1acc876e07ce5d4d547e8db4dcc7fdfd6af200644c80bfa6c98fc603d2e30c7a7525bd517d25725d796a834bb330a7e3f')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.vuplus-3cc5547eb55b1711cac1068bb3a5096e46b2cecd"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.vuplus-3cc5547eb55b1711cac1068bb3a5096e46b2cecd/build"
  make DESTDIR="$pkgdir" install
}
