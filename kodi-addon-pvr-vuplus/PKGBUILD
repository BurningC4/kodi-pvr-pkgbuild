# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-vuplus
pkgbase=${pkgname}
pkgver=21.2.1
pkgrel=1
pkgdesc="Kodi's Enigma2 client add-on"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.vuplus"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.vuplus.tar.gz::https://github.com/kodi-pvr/pvr.vuplus/archive/720a7755f24955b7907c0e68c6c146a4e583f265.tar.gz")
sha512sums=('f9b70479c601511cf7466fad0d92646aa42e523d1e5295d17b4c66a780b579604861a183b6d704912571e3ed588b9809e13726ad63b43019d13db7cfb12c211f')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.vuplus-720a7755f24955b7907c0e68c6c146a4e583f265"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.vuplus-720a7755f24955b7907c0e68c6c146a4e583f265/build"
  make DESTDIR="$pkgdir" install
}
