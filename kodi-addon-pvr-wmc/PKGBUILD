# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-wmc
pkgbase=${pkgname}
pkgver=21.0.1
pkgrel=1
pkgdesc="Kodi's Windows Media Center client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.wmc"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.wmc.tar.gz::https://github.com/kodi-pvr/pvr.wmc/archive/5013975759deaf4488a8255c62afca389bef2f29.tar.gz")
sha512sums=('ebc913a02d2fa83474f679d8ce534f4f4ac372223335379dd78dd4f3706108343b9a748d250145701eecb95cec544c0125f59117d2e554f34b4fae262fe8a761')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.wmc-5013975759deaf4488a8255c62afca389bef2f29"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.wmc-5013975759deaf4488a8255c62afca389bef2f29/build"
  make DESTDIR="$pkgdir" install
}
