# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-wmc
pkgbase=${pkgname}
pkgver=21.0.2
pkgrel=1
pkgdesc="Kodi's Windows Media Center client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.wmc"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.wmc.tar.gz::https://github.com/kodi-pvr/pvr.wmc/archive/c333eb6b8a8d576565f0dc3935840138c3d409c3.tar.gz")
sha512sums=('a7c4047b2935f8a209b04878347590c267ca970bd13bfc5b55106e3de902e723d047aaff03044887147ade0390ec87e49a17aadf6e6c918df7b2cb604eef09e9')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.wmc-c333eb6b8a8d576565f0dc3935840138c3d409c3"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.wmc-c333eb6b8a8d576565f0dc3935840138c3d409c3/build"
  make DESTDIR="$pkgdir" install
}
