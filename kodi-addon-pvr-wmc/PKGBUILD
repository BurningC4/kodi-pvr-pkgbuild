# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-wmc
pkgbase=${pkgname}
pkgver=21.0.3
pkgrel=1
pkgdesc="Kodi's Windows Media Center client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.wmc"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.wmc.tar.gz::https://github.com/kodi-pvr/pvr.wmc/archive/050b53d6db78dd4331dafb06012bdbc85865080c.tar.gz")
sha512sums=('9e8b20a56f23c8fd4537af220065ebb5c43dcec74b9fbb09dd26c147ffb607d10d218291b7dbe92123585738be56fa63f43a3baa77fdcbb0b34cc1e0c9a46ff3')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.wmc-050b53d6db78dd4331dafb06012bdbc85865080c"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.wmc-050b53d6db78dd4331dafb06012bdbc85865080c/build"
  make DESTDIR="$pkgdir" install
}
