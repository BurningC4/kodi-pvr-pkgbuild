# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-wmc
pkgbase=${pkgname}
pkgver=21.0.3
pkgrel=2
pkgdesc="Kodi's Windows Media Center client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.wmc"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.wmc.tar.gz::https://github.com/kodi-pvr/pvr.wmc/archive/fcde21f0d7d387a8f816f4625d1c83e2a74e5042.tar.gz")
sha512sums=('4d1f3ecd26191f540d804da45d6eb151a8b27bd19dfa58568523cf6c021ea5a11a82710e1ddef26172d3f8babe2fd0b1c39c06200270940fde0212ad60b62ab6')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.wmc-fcde21f0d7d387a8f816f4625d1c83e2a74e5042"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.wmc-fcde21f0d7d387a8f816f4625d1c83e2a74e5042/build"
  make DESTDIR="$pkgdir" install
}
