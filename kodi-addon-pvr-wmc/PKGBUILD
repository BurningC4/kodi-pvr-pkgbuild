# Maintainer: BurningC4 <wangweichen1995@hotmail.com>

pkgname=kodi-addon-pvr-wmc
pkgbase=${pkgname}
pkgver=21.0.1
pkgrel=2
pkgdesc="Kodi's Windows Media Center client addon"
arch=('i686' 'x86_64' 'armv6h' 'armv7h' 'aarch64')
url="https://github.com/kodi-pvr/pvr.wmc"
license=('GPL')
groups=('kodi-addons')
makedepends=('cmake' 'kodi-platform' 'git' 'kodi-dev')
depends=('kodi' 'p8-platform')
source=("pvr.wmc.tar.gz::https://github.com/kodi-pvr/pvr.wmc/archive/5cc263964d76d8b7c97bd98451a058b4492286ad.tar.gz")
sha512sums=('5c3dd658860e8f347bc574cae352e34608d476ded9baa3dea2731abc0fd3d408c6c3906ad65b2ec026f37c4874ce0114353c96abf9ed3708ae33c28247e6d82e')

_prefix='/usr'

build() {
  msg "Starting make..."

  cd "$srcdir/pvr.wmc-5cc263964d76d8b7c97bd98451a058b4492286ad"
  mkdir -p build && pushd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_prefix \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
  popd
}

package() {
  cd "$srcdir/pvr.wmc-5cc263964d76d8b7c97bd98451a058b4492286ad/build"
  make DESTDIR="$pkgdir" install
}
